+function randomDocument(next: () => number): string {
+	let text = "";
+	const pieces = 8 + Math.floor(next() * 30);
+	for (let i = 0; i < pieces; i++) {
+		text += PIECES[Math.floor(next() * PIECES.length)]!.replaceAll("{w}", String(Math.floor(next() * 50)));
+	}
+	return text;
