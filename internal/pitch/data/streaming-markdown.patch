+	for (let i = 0; i < before.length; i++) {
+		if (after[i] !== before[i]) {
+			const what = i % 2 === 0 ? "lines" : "tokens";
+			assert.deepStrictEqual(JSON.parse(after[i]!), JSON.parse(before[i]!), `${label}: ${what}, step ${i >> 1}`);
+		}
+	}
