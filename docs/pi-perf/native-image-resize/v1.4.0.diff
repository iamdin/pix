@@ -0,0 +1,82 @@
+/**
+ * Image resizing with Bun's native image pipeline (`Bun.Image`), used when the runtime has it.
+ *
+ * It follows the strategy of resizeImageInProcess() (same target sizes, PNG then JPEG quality steps,
+ * shrinking by 0.75) without Photon. Photon is WebAssembly, and Bun's AOT executables run WebAssembly
+ * without a JIT, so resizing a large image with it takes tens of seconds there. `Bun.Image` decodes,
+ * resizes and encodes natively off the JS thread, and applies the JPEG EXIF orientation itself.
+ */
+import { DEFAULT_OPTIONS, type ImageResizeOptions, type ResizedImage } from "./image-resize-core.ts";
+
+interface BunImage {
+	metadata(): Promise<{ width: number; height: number }>;
+	resize(width: number, height: number, options: { filter: "lanczos3" }): BunImage;
+	png(): BunImage;
+	jpeg(options: { quality: number }): BunImage;
+	bytes(): Promise<Uint8Array>;
+}
+
+export type BunImageConstructor = new (input: Uint8Array) => BunImage;
+
+export function getBunImage(): BunImageConstructor | undefined {
+	return (globalThis as { Bun?: { Image?: BunImageConstructor } }).Bun?.Image;
+}
+
+/** Rejects when Bun cannot decode the image, so the caller can try Photon. */
+export async function resizeImageWithBun(
+	Image: BunImageConstructor,
+	inputBytes: Uint8Array,
+	mimeType: string,
+	options?: ImageResizeOptions,
+): Promise<ResizedImage | null> {
+	const opts = { ...DEFAULT_OPTIONS, ...options };
+	const inputBase64Size = Math.ceil(inputBytes.byteLength / 3) * 4;
+	// Width and height after the EXIF orientation, as Photon reports them after applyExifOrientation().
+	const { width: originalWidth, height: originalHeight } = await new Image(inputBytes).metadata();
+	const format = mimeType.split("/")[1] ?? "png";
+
+	if (originalWidth <= opts.maxWidth && originalHeight <= opts.maxHeight && inputBase64Size < opts.maxBytes) {
+		return {
+			data: Buffer.from(inputBytes).toString("base64"),
+			mimeType: mimeType || `image/${format}`,
+			originalWidth,
+			originalHeight,
+			width: originalWidth,
+			height: originalHeight,
+			wasResized: false,
+		};
+	}
+
+	let width = originalWidth;
+	let height = originalHeight;
+	if (width > opts.maxWidth) {
+		height = Math.round((height * opts.maxWidth) / width);
+		width = opts.maxWidth;
+	}
+	if (height > opts.maxHeight) {
+		width = Math.round((width * opts.maxHeight) / height);
+		height = opts.maxHeight;
+	}
+
+	const qualitySteps = Array.from(new Set([opts.jpegQuality, 85, 70, 55, 40]));
+	while (true) {
+		const resized = () => new Image(inputBytes).resize(width, height, { filter: "lanczos3" });
+		const encoders = [
+			{ mimeType: "image/png", encode: () => resized().png() },
+			...qualitySteps.map((quality) => ({ mimeType: "image/jpeg", encode: () => resized().jpeg({ quality }) })),
+		];
+		// Same order as resizeImageInProcess(), which takes the first candidate under the limit.
+		for (const encoder of encoders) {
+			const data = Buffer.from(await encoder.encode().bytes()).toString("base64");
+			if (Buffer.byteLength(data, "utf-8") < opts.maxBytes) {
+				return { data, mimeType: encoder.mimeType, originalWidth, originalHeight, width, height, wasResized: true };
+			}
+		}
+		if (width === 1 && height === 1) return null;
+		const nextWidth = width === 1 ? 1 : Math.max(1, Math.floor(width * 0.75));
+		const nextHeight = height === 1 ? 1 : Math.max(1, Math.floor(height * 0.75));
+		if (nextWidth === width && nextHeight === height) return null;
+		width = nextWidth;
+		height = nextHeight;
+	}
+}
