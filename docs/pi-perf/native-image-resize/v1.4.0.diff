@@ -0,0 +1,72 @@
+// Runs under Bun (`bun test ./test/image-resize-bun.bun.ts`): Bun.Image does not exist in Node, where vitest runs.
+import { describe, expect, it } from "vitest";
+import { getBunImage, resizeImageWithBun } from "../src/utils/image-resize-bun.ts";
+import { resizeImageInProcess } from "../src/utils/image-resize-core.ts";
+
+const Image = getBunImage()!;
+// A 2x2 PNG to scale into test images.
+const TINY_PNG = Buffer.from(
+	"iVBORw0KGgoAAAANSUhEUgAAAAIAAAACAQMAAABIeJ9nAAAABlBMVEX/AAD///9BHTQRAAAADElEQVQI12NgYGAAAAAEAAEnNCcKAAAAAElFTkSuQmCC",
+	"base64",
+);
+
+async function photo(width: number, height: number) {
+	return new Image(TINY_PNG).resize(width, height, { filter: "lanczos3" }).png().bytes();
+}
+
+function rotatedJpeg(jpeg: Uint8Array) {
+	const exif = Buffer.concat([
+		Buffer.from("Exif\0\0"),
+		Buffer.from("49492a0008000000010012010300010000000600000000000000", "hex"),
+	]);
+	const app1 = Buffer.concat([Buffer.from([0xff, 0xe1, (exif.length + 2) >> 8, (exif.length + 2) & 255]), exif]);
+	return new Uint8Array(Buffer.concat([jpeg.subarray(0, 2), app1, jpeg.subarray(2)]));
+}
+
+describe("resizeImageWithBun", () => {
+	it("is available under Bun", () => {
+		expect(Image).toBeDefined();
+	});
+
+	it("returns a small image unchanged, like Photon", async () => {
+		const input = await photo(100, 50);
+		const bun = await resizeImageWithBun(Image, input, "image/png");
+		expect(bun).toEqual(await resizeImageInProcess(input, "image/png"));
+	});
+
+	it("resizes a large image to the same size and format as Photon", async () => {
+		const input = await photo(3000, 1000);
+		const bun = await resizeImageWithBun(Image, input, "image/png");
+		const photon = await resizeImageInProcess(input, "image/png");
+		expect(bun).toMatchObject({
+			width: 2000,
+			height: 667,
+			originalWidth: 3000,
+			originalHeight: 1000,
+			wasResized: true,
+		});
+		expect({ ...bun, data: "" }).toEqual({ ...photon!, data: "" });
+		expect(await new Image(Buffer.from(bun!.data, "base64")).metadata()).toMatchObject({ width: 2000, height: 667 });
+	});
+
+	it("reports dimensions after the EXIF orientation, like Photon", async () => {
+		const input = rotatedJpeg(await new Image(await photo(40, 20)).jpeg({ quality: 80 }).bytes());
+		const options = { maxWidth: 10, maxHeight: 10 };
+		const bun = await resizeImageWithBun(Image, input, "image/jpeg", options);
+		const photon = await resizeImageInProcess(input, "image/jpeg", options);
+		expect(bun).toMatchObject({ originalWidth: 20, originalHeight: 40, width: 5, height: 10 });
+		expect({ ...bun, data: "", mimeType: "" }).toEqual({ ...photon!, data: "", mimeType: "" });
+	});
+
+	it("stays under maxBytes by lowering quality and size", async () => {
+		const input = await photo(3000, 3000);
+		const bun = await resizeImageWithBun(Image, input, "image/png", { maxBytes: 2000 });
+		expect(bun).not.toBeNull();
+		expect(Buffer.byteLength(bun!.data)).toBeLessThan(2000);
+		expect(bun!.width).toBeLessThan(2000);
+	});
+
+	it("rejects what it cannot decode, so resizeImage() falls back to Photon", async () => {
+		await expect(resizeImageWithBun(Image, new Uint8Array([1, 2, 3, 4]), "image/png")).rejects.toThrow();
+	});
+});
