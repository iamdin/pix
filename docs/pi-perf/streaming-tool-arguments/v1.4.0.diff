diff --git a/packages/ai/test/streaming-json-budget.test.ts b/packages/ai/test/streaming-json-budget.test.ts
new file mode 100644
index 000000000..ce982682a
--- /dev/null
+++ b/packages/ai/test/streaming-json-budget.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from "vitest";
+import {
+	parseStreamingJson,
+	parseStreamingJsonWhileStreaming,
+	parseToolCallArguments,
+} from "../src/utils/json-parse.ts";
+
+describe("streaming argument parse budget", () => {
+	it("parses every small prefix with the unchanged parser", () => {
+		const samples = [
+			JSON.stringify({ path: "日本語/😀.ts", content: 'a\\b\n\t"x"', nested: [true, null, -1.2e5] }),
+			'{"text":"ab\\u00e9 \\url{x}"}',
+			'{"x":[1,2,{"y":false}],"bad":.5}',
+			'{"__proto__":{"x":1}}',
+		];
+		for (const json of samples) {
+			const block = {};
+			let current: unknown;
+			for (let end = 0; end <= json.length; end++) {
+				const prefix = json.slice(0, end);
+				current = parseStreamingJsonWhileStreaming(block, prefix, current);
+				expect(current).toEqual(parseStreamingJson(prefix));
+			}
+		}
+	});
+
+	it("bounds total reparsed input for tiny deltas and preserves final arguments", () => {
+		const expected = { path: "out.ts", content: '日本語 😀 \\ "\n'.repeat(5000) };
+		const json = JSON.stringify(expected);
+		for (const step of [1, 16, 97, 4096]) {
+			const block = {};
+			let current: unknown;
+			let work = 0;
+			let lastLength = 0;
+			for (let end = step; end < json.length + step; end += step) {
+				const prefix = json.slice(0, end);
+				const next = parseStreamingJsonWhileStreaming(block, prefix, current);
+				if (next !== current) {
+					work += prefix.length;
+					lastLength = prefix.length;
+					expect(next).toEqual(parseStreamingJson(prefix));
+				} else {
+					expect(prefix.length - lastLength).toBeLessThan(lastLength / 8);
+				}
+				current = next;
+			}
+			// Small inputs are eager; after that the geometric schedule must stay linear.
+			expect(work).toBeLessThan(1024 * 1024 + json.length * 10);
+			expect(parseToolCallArguments(json)).toEqual({ arguments: expected });
+		}
+	});
+
+	it("isolates interleaved calls even when their public ids match", () => {
+		const first = { id: "same" };
+		const second = { id: "same" };
+		const prefix = `{"content":"${"a".repeat(2000)}`;
+		const current = parseStreamingJsonWhileStreaming(first, prefix, undefined);
+		expect(parseStreamingJsonWhileStreaming(first, `${prefix}x`, current)).toBe(current);
+		expect(parseStreamingJsonWhileStreaming(second, `${prefix}y`, {})).toEqual(parseStreamingJson(`${prefix}y`));
+		expect(Object.keys(first)).toEqual(["id"]);
+	});
+
+	it("does not skip the first parse, an absent value, or a shorter restart", () => {
+		const block = {};
+		const json = JSON.stringify({ content: "a".repeat(2000) });
+		const current = parseStreamingJsonWhileStreaming(block, json, {});
+		expect(current).toEqual(JSON.parse(json));
+		expect(parseStreamingJsonWhileStreaming(block, json, undefined)).toEqual(current);
+		expect(parseStreamingJsonWhileStreaming(block, '{"next":1}', current)).toEqual({ next: 1 });
+	});
+
+	it("keeps final validation separate from a cached valid prefix", () => {
+		const block = {};
+		const prefix = JSON.stringify({ content: "a".repeat(2000) });
+		const current = parseStreamingJsonWhileStreaming(block, prefix, undefined);
+		for (const final of [`${prefix}garbage`, prefix.slice(0, -1)]) {
+			expect(parseToolCallArguments(final).argumentsError).toBeDefined();
+			expect(parseToolCallArguments(final).arguments).toEqual({});
+		}
+		const replacement = JSON.stringify({ content: "b".repeat(2000) });
+		expect(parseToolCallArguments(replacement).arguments).not.toEqual(current);
+		expect(parseToolCallArguments(replacement).arguments).toEqual(JSON.parse(replacement));
+	});
+});
