@@ -0,0 +1,225 @@
+import { describe, expect, it, vi } from "vitest";
+
+const bedrock = vi.hoisted(() => ({ events: [] as unknown[] }));
+vi.mock("@aws-sdk/client-bedrock-runtime", () => ({
+	BedrockRuntimeClient: class {
+		middlewareStack = { add: () => undefined };
+		async send() {
+			return {
+				$metadata: {},
+				stream: (async function* () {
+					yield* bedrock.events;
+				})(),
+			};
+		}
+	},
+	BedrockRuntimeServiceException: class extends Error {},
+	ConverseStreamCommand: class {},
+	StopReason: {
+		END_TURN: "end_turn",
+		STOP_SEQUENCE: "stop_sequence",
+		MAX_TOKENS: "max_tokens",
+		MODEL_CONTEXT_WINDOW_EXCEEDED: "model_context_window_exceeded",
+		TOOL_USE: "tool_use",
+	},
+	CachePointType: { DEFAULT: "default" },
+	CacheTTL: { ONE_HOUR: "ONE_HOUR" },
+	ConversationRole: { ASSISTANT: "assistant", USER: "user" },
+	ImageFormat: {},
+	ToolResultStatus: { ERROR: "error", SUCCESS: "success" },
+}));
+
+import { stream as anthropic } from "../src/api/anthropic-messages.ts";
+import { stream as converse } from "../src/api/bedrock-converse-stream.ts";
+import { stream as mistral } from "../src/api/mistral-conversations.ts";
+import { stream as completions } from "../src/api/openai-completions.ts";
+import { stream as responses } from "../src/api/openai-responses.ts";
+import { stream as pi } from "../src/api/pi-messages.ts";
+import type { Api, Model } from "../src/types.ts";
+import { parseToolCallArguments } from "../src/utils/json-parse.ts";
+import { normalizeContext } from "../src/utils/transcript.ts";
+
+const apis = [
+	"openai-completions",
+	"anthropic-messages",
+	"openai-responses",
+	"mistral-conversations",
+	"bedrock-converse-stream",
+	"pi-messages",
+] as const;
+const usage = {
+	input: 1,
+	output: 1,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 2,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+function model<T extends Api>(api: T): Model<T> {
+	return {
+		api,
+		id: "test",
+		name: "test",
+		provider: "test",
+		baseUrl: "http://127.0.0.1:1",
+		reasoning: false,
+		input: ["text"],
+		contextWindow: 100000,
+		maxTokens: 20000,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	};
+}
+
+function events(api: (typeof apis)[number], json: string, final = json, omitBlockStop = false): unknown[] {
+	const deltas = [];
+	for (let i = 0; i < json.length; i += 16) deltas.push(json.slice(i, i + 16));
+	if (api === "openai-completions" || api === "mistral-conversations") {
+		return [
+			...deltas.map((delta) => ({
+				id: "chat-1",
+				choices: [
+					{
+						index: 0,
+						delta: {
+							tool_calls: [
+								{ index: 0, id: "call_1", type: "function", function: { name: "write", arguments: delta } },
+							],
+						},
+					},
+				],
+			})),
+			{ id: "chat-1", choices: [{ index: 0, delta: {}, finish_reason: "tool_calls" }] },
+		];
+	}
+	if (api === "anthropic-messages") {
+		return [
+			{ type: "message_start", message: { id: "msg_1", model: "test", usage: {} } },
+			{
+				type: "content_block_start",
+				index: 0,
+				content_block: { type: "tool_use", id: "call_1", name: "write", input: {} },
+			},
+			...deltas.map((delta) => ({
+				type: "content_block_delta",
+				index: 0,
+				delta: { type: "input_json_delta", partial_json: delta },
+			})),
+			{ type: "content_block_stop", index: 0 },
+			{ type: "message_delta", delta: { stop_reason: "tool_use" }, usage: {} },
+			{ type: "message_stop" },
+		];
+	}
+	if (api === "bedrock-converse-stream") {
+		return [
+			{ messageStart: { role: "assistant" } },
+			{ contentBlockStart: { contentBlockIndex: 0, start: { toolUse: { toolUseId: "call_1", name: "write" } } } },
+			...deltas.map((delta) => ({
+				contentBlockDelta: { contentBlockIndex: 0, delta: { toolUse: { input: delta } } },
+			})),
+			...(omitBlockStop ? [] : [{ contentBlockStop: { contentBlockIndex: 0 } }]),
+			{ messageStop: { stopReason: "tool_use" } },
+		];
+	}
+	if (api === "pi-messages") {
+		return [
+			{ type: "start" },
+			{ type: "toolcall_start", contentIndex: 0, id: "call_1", toolName: "write" },
+			...deltas.map((delta) => ({ type: "toolcall_delta", contentIndex: 0, delta })),
+			{
+				type: "toolcall_end",
+				contentIndex: 0,
+				toolCall: { type: "toolCall", id: "call_1", name: "write", ...parseToolCallArguments(final) },
+			},
+			{ type: "done", reason: "toolUse", usage },
+		];
+	}
+	const item = { type: "function_call", id: "fc_1", call_id: "call_1", name: "write", arguments: "" };
+	return [
+		{ type: "response.created", response: { id: "resp_1" } },
+		{ type: "response.output_item.added", output_index: 0, item },
+		...deltas.map((delta) => ({ type: "response.function_call_arguments.delta", output_index: 0, delta })),
+		{ type: "response.function_call_arguments.done", output_index: 0, arguments: final },
+		{ type: "response.output_item.done", output_index: 0, item: { ...item, arguments: final } },
+		{ type: "response.completed", response: { id: "resp_1", status: "completed", output: [] } },
+	];
+}
+
+function run(api: (typeof apis)[number], json: string, final = json, omitBlockStop = false) {
+	const wire = events(api, json, final, omitBlockStop);
+	bedrock.events = wire;
+	const body = wire
+		.map((event) => {
+			const kind = (event as { type?: string }).type;
+			return `${kind ? `event: ${kind}\n` : ""}data: ${JSON.stringify(event)}\n\n`;
+		})
+		.join("");
+	const options = {
+		apiKey: "test",
+		cacheRetention: "none" as const,
+		maxRetries: 0,
+		fetch: vi.fn<typeof fetch>(async () => new Response(body, { headers: { "content-type": "text/event-stream" } })),
+	};
+	const context = normalizeContext({ messages: [{ role: "user", content: "write", timestamp: 0 }] });
+	switch (api) {
+		case "openai-completions":
+			return completions(model(api), context, options);
+		case "anthropic-messages":
+			return anthropic(model(api), context, options);
+		case "openai-responses":
+			return responses(model(api), context, options);
+		case "mistral-conversations":
+			return mistral(model(api), context, options);
+		case "bedrock-converse-stream":
+			return converse(model(api), context, options);
+		case "pi-messages":
+			return pi(model(api), context, options);
+	}
+}
+
+const expected = { path: "日本語/😀.ts", content: `${'const x = "\\😀";\n'.repeat(500)}FINAL TAIL` };
+const json = JSON.stringify(expected);
+
+describe("coalesced tool arguments at provider boundaries", () => {
+	for (const api of apis) {
+		it(`${api} preserves every raw delta and the fully parsed terminal call`, async () => {
+			const stream = run(api, json);
+			let raw = "";
+			let ends = 0;
+			for await (const event of stream) {
+				if (event.type === "toolcall_delta") raw += event.delta;
+				if (event.type === "toolcall_end") {
+					ends++;
+					expect(event.toolCall.arguments).toEqual(expected);
+				}
+			}
+			const result = await stream.result();
+			expect(result.stopReason, result.errorMessage).toBe("toolUse");
+			expect(raw).toBe(json);
+			expect(ends).toBe(1);
+			expect(result.content[0]).toMatchObject({ type: "toolCall", arguments: expected });
+			expect(Object.keys(result.content[0]).sort()).toEqual(["arguments", "id", "name", "type"]);
+		});
+		it(`${api} rejects malformed final JSON despite a cached usable prefix`, async () => {
+			const result = await run(api, `${json}BAD`).result();
+			const call = result.content[0];
+			expect(call.type).toBe("toolCall");
+			if (call.type !== "toolCall") throw new Error("missing call");
+			expect(call.arguments).toEqual({});
+			expect(call.argumentsError).toContain("Received arguments:");
+		});
+	}
+	for (const api of ["openai-responses", "pi-messages"] as const) {
