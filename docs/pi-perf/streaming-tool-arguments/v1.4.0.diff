+const streamingParseLengths = new WeakMap<object, number>();
+
+/** Only for append-only deltas; final/replacement arguments must still be parsed in full. */
+export function parseStreamingJsonWhileStreaming<T = Record<string, unknown>>(
+	block: object,
+	partialJson: string | undefined,
+	current: T | undefined,
+): T {
+	const length = partialJson?.length ?? 0;
+	const parsed = streamingParseLengths.get(block);
+	// shortcut: large previews update at 12.5% growth; use an incremental parser if per-delta snapshots are needed.
+	if (
+		current !== undefined &&
+		parsed !== undefined &&
+		parsed >= 1024 &&
+		length >= parsed &&
+		length - parsed < Math.floor(parsed / 8)
+	) {
+		return current;
+	}
+	streamingParseLengths.set(block, length);
+	return parseStreamingJson<T>(partialJson);
+}
